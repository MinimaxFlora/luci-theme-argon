{#
	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-bootstrap and MUI and Argon Template

	luci-theme-argon
	Copyright 2020 Jerryk <jerrykuku@gmail.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-bootstrap:
	Copyright 2008 Steven Barth <steven@midlink.org>
	Copyright 2008-2016 Jo-Philipp Wich <jow@openwrt.org>
	Copyright 2012 David Menting <david@nut-bolt.nl>

	MUI:
	https://github.com/muicss/mui

	Argon Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{% include("themes/" + theme + "/out_header_login") %}
{%
	import * as fs from 'fs';
	import { cursor } from 'uci';

	let cfg = cursor();
	// Per-request pseudo-random state for selecting local backgrounds.
	let lcgState = (+time()) % 2147483648;

	function randomIndex(limit) {
		lcgState = (lcgState * 1103515245 + 12345) % 2147483648;

		return lcgState % limit;
	}

	//Fetch Local Background Media

	const imageTypes = " jpg jpeg png gif webp ";
	const videoTypes = " mp4 webm ";
	const allTypes = imageTypes + videoTypes;

	function fetchMedia(path, themeDir) {
		let backgroundTable = [];
		for (f in (fs.lsdir(path))) {
			let parts = split(f, '.');
			let ext = lc(parts?.[length(parts) - 1]);
			if (ext && index(allTypes, " " + ext + " ") != -1) {
				let bg = {};
				bg.type = ext;
				bg.url = themeDir + http.urlencode(f);
				push(backgroundTable, bg);
			}
		}
		return backgroundTable;
	}

	function selectBackground(themeDir) {
		let bgUrl = media + "/img/bg1.jpg";
		let backgroundType = "Image";
		let mimeType = "";

		if (fs.access("/etc/config/argon")) {
			let online_wallpaper = cfg.get_first('argon', 'global', 'online_wallpaper') ?? (cfg.get_first('argon', 'global', 'bing_background') == '1' ? 'bing' : null);
			if (online_wallpaper && online_wallpaper != "none") {
				const picurl = ubus.call("luci.argon_wallpaper", "get_url") ?? {};
				if (type(picurl?.url) == 'string' && match(picurl.url, /^https:\/\/[^[:space:]"'<>]+$/)) {
					bgUrl = picurl.url;
					return {bgUrl, backgroundType, mimeType};
				}
			}
		}

		let background = fetchMedia("/www" + themeDir, themeDir);
		if ( length(background) > 0 ) {
			let currentBg = background[randomIndex(length(background))];
			bgUrl = currentBg.url;
			if (index(videoTypes, " " + currentBg.type + " ") != -1) {
				backgroundType = "Video";
				mimeType = "video/" + currentBg.type;
			}
		}

		return {bgUrl, backgroundType, mimeType};
	}

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const themeDir = media + "/background/";
	const bgArry = selectBackground(themeDir);

%}
<!-- Login Page Start -->
<div class="login-page">
	{% if ( bgArry.backgroundType == "Video" ): %}
	<!-- Video Player Start -->
	<div class="video">
		<video loop muted playsinline id="video" poster="{{ media }}/img/bg1.jpg">
			<source src="{{ entityencode(bgArry.bgUrl, true) }}" type="{{ bgArry.mimeType }}">
		</video>
	</div>
	<button type="button" class="volume-control mute" aria-label="{{ entityencode(_('Mute background video'), true) }}" aria-pressed="true"></button>
	<script>
		var backgroundVideo = document.getElementById("video");
		var motionPreference = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
		function updateBackgroundMotion() {
			if (motionPreference && motionPreference.matches)
				backgroundVideo.pause();
			else {
				var playResult = backgroundVideo.play();
				if (playResult && playResult.catch)
					playResult.catch(function() {});
			}
		}
		updateBackgroundMotion();
		if (motionPreference) {
			if (motionPreference.addEventListener)
				motionPreference.addEventListener('change', updateBackgroundMotion);
			else if (motionPreference.addListener)
				motionPreference.addListener(updateBackgroundMotion);
		}
		document.querySelector(".volume-control").addEventListener("click", function(){
			if(this.classList.contains("mute")){
				this.classList.remove("mute");
				backgroundVideo.muted = false;
				this.setAttribute('aria-pressed', 'false');
			}else{
				this.classList.add("mute");
				backgroundVideo.muted = true;
				this.setAttribute('aria-pressed', 'true');
			}
		});
	</script>
	<!-- Video Player End -->
	{% else %}
	<!-- Image Background Start -->
	<div class="main-bg" id="main-bg"><img src="{{ entityencode(bgArry.bgUrl, true) }}" data-fallback="{{ media }}/img/bg1.jpg" onerror="this.onerror=null;this.src=this.dataset.fallback" alt=""></div>
	<!-- Image Background End -->
	{% endif %}
	<!-- Login Container Start -->
	<div class="login-container">
		<div class="login-form">
			<!-- Logo Start -->
			<a class="brand" href="/"><img src="{{ media }}/img/argon.svg" class="icon">
				<span class="brand-text">{{ hostname }}</span>
			</a>
			<!-- Logo End -->
			<!-- Login Form Start -->
			<form class="form-login" method="post" action="{{ entityencode(http.getenv("REQUEST_URI"), true) }}">

				{#-
				 `auth_plugin` is set only on the render that follows an ACCEPTED password
				 (dispatcher.uc), so it is what separates "the password was wrong" from "the
				 password was right and a plugin wants more". Gating the credentials alert on
				 `!auth_plugin` and showing `auth_message` beside it rather than instead of it
				 covers all four states: a wrong password, a wrong password with a challenge
				 already pending, the challenge prompt itself, and a failed challenge.
				-#}
				{%- if (fuser && !auth_plugin): %}
				<div class="errorbox">{{ _('Invalid username and/or password! Please try again.') }}</div>
				{% endif -%}

				{%- if (auth_message): %}
				<div class="errorbox">{{ auth_message }}</div>
				{% endif -%}

				<div class="input-container">
					<div class="input-group user-icon">
						<label class="visually-hidden" for="cbi-input-user">{{ _('Username') }}</label>
						<input class="cbi-input-user" id="cbi-input-user" type="text" name="luci_username" value="{{ entityencode(duser, true) }}" />
						<span class="border" aria-hidden="true"></span>
					</div>
					<div class="input-group pass-icon">
						<label class="visually-hidden" for="cbi-input-password">{{ _('Password') }}</label>
						<div class="password-field">
							<input class="cbi-input-password" id="cbi-input-password" type="password" name="luci_password" />
							<button type="button" class="password-toggle" aria-label="{{ entityencode(_('Reveal/hide password'), true) }}" aria-pressed="false" title="{{ entityencode(_('Reveal/hide password'), true) }}">
								<svg class="password-toggle-show" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
								<svg class="password-toggle-hide" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
							</button>
							<span class="border" aria-hidden="true"></span>
						</div>
					</div>
					{%- if (auth_fields): %}
					{%- for (let field in auth_fields): %}
					{#- Keep a plugin's format hint as the placeholder, while its label or
					 field name provides an accessible name for the input. -#}
						<div class="input-group pass-icon">
							<label class="visually-hidden" for="{{ entityencode(field.name, true) }}">{{ entityencode(_(field.label || field.name)) }}</label>
							<input class="cbi-input-text" id="{{ entityencode(field.name, true) }}" type="{{ entityencode(field.type ?? 'text', true) }}" name="{{ entityencode(field.name, true) }}"
								placeholder="{{ entityencode(_(field.label ?? field.placeholder ?? field.name), true) }}"
								{% if (field.placeholder): %}title="{{ entityencode(field.placeholder, true) }}"{% endif %}
								{% if (field.inputmode): %}inputmode="{{ entityencode(field.inputmode, true) }}"{% endif %}
								{% if (field.pattern): %}pattern="{{ entityencode(field.pattern, true) }}"{% endif %}
								{% if (field.maxlength): %}maxlength="{{ entityencode('' + field.maxlength, true) }}"{% endif %}
								{% if (field.autocomplete): %}autocomplete="{{ entityencode(field.autocomplete, true) }}"{% endif %}
								{% if (field.required): %}required{% endif %} />
							<span class="border" aria-hidden="true"></span>
					</div>
					{%- endfor %}
					{%- endif %}
				</div>
				{%- if (auth_html): %}
				<div class="auth-plugin">{{ auth_html }}</div>
				{% endif -%}

				<div>
					<input type="submit" value="{{ _('Log in') }}" class="cbi-button cbi-button-apply" />
				</div>
				{#- Loaded last so the markup a plugin emitted through `auth_html` is already
				 in the document when its script runs. -#}
				{%- if (auth_assets): %}
				{%- for (let asset in auth_assets): %}
				{%- if (asset.type == 'script'): %}
				<script src="{{ asset.src }}"></script>
				{%- endif %}
				{%- endfor %}
				{%- endif %}
			</form>
			<!-- Login Form End -->
			<script type="text/javascript">//<![CDATA[
				var passwordInput = document.getElementById('cbi-input-password');
				var passwordToggle = document.querySelector('.password-toggle');
				if (passwordInput && passwordToggle) {
					passwordToggle.addEventListener('click', function () {
						var reveal = passwordInput.type === 'password';
						passwordInput.type = reveal ? 'text' : 'password';
						this.classList.toggle('is-visible', reveal);
						this.setAttribute('aria-pressed', reveal ? 'true' : 'false');
					});
				}
				var input = document.getElementsByName('luci_password')[0];
				if (input)
					input.focus();
			//]]></script>
{% include("themes/" + theme + "/footer_login") %}
